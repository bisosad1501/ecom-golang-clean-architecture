			"item": [
				{
					"name": "📋 Payment Operations",
					"description": "Payment processing and management endpoints",
					"item": [
						{
							"name": "Create Checkout Session",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{jwt_token}}"
									},
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"amount\": 99.99,\n  \"currency\": \"USD\",\n  \"description\": \"Order payment\",\n  \"success_url\": \"https://example.com/success\",\n  \"cancel_url\": \"https://example.com/cancel\",\n  \"metadata\": {\n    \"customer_id\": \"{{user_id}}\",\n    \"order_number\": \"{{order_number}}\"\n  }\n}"
								},
