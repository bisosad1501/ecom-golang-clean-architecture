							{
								"name": "Get Category Children",
								"request": {
									"method": "GET",
									"header": [],
									"url": {
										"raw": "{{base_url}}/api/v1/categories/{{category_id}}/children",
										"host": ["{{base_url}}"],
										"path": ["api", "v1", "categories", "{{category_id}}", "children"]
									},
									"description": "Get direct children of a specific category."
								},
								"response": [],
								"event": [
									{
										"listen": "test",
										"script": {
											"exec": [
												"pm.test('Status code is 200', function () {",
												"    pm.response.to.have.status(200);",
												"});",
												"",
												"pm.test('Response contains child categories', function () {",
												"    const responseJson = pm.response.json();",
												"    pm.expect(responseJson).to.have.property('data');",
