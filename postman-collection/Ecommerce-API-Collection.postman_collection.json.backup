												"    pm.response.to.have.status(200);",
												"});",
												"",
												"pm.test('Response contains category tree', function () {",
												"    const responseJson = pm.response.json();",
												"    pm.expect(responseJson).to.have.property('data');",
												"    pm.expect(responseJson.data).to.be.an('array');",
												"});"
											],
											"type": "text/javascript"
										}
									}
								]
							},
							{
								"name": "Get Root Categories",
								"request": {
									"method": "GET",
									"header": [],
									"url": {
										"raw": "{{base_url}}/api/v1/categories/root",
										"host": ["{{base_url}}"],
										"path": ["api", "v1", "categories", "root"]
									},
									"description": "Get all root level categories (categories without parent)."
								},
								"response": [],
								"event": [
									{
										"listen": "test",
										"script": {
											"exec": [
												"pm.test('Status code is 200', function () {",
												"    pm.response.to.have.status(200);",
												"});",
												"",
												"pm.test('Response contains root categories', function () {",
												"    const responseJson = pm.response.json();",
												"    pm.expect(responseJson).to.have.property('data');",
												"    pm.expect(responseJson.data).to.be.an('array');",
												"});"
											],
											"type": "text/javascript"
										}
									}
								]
